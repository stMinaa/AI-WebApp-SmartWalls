#!/usr/bin/env sh

echo "Running pre-commit checks..."
echo ""

# ESLint v9 compatibility: use legacy .eslintrc config format
export ESLINT_USE_FLAT_CONFIG=false

# Step 1: lint-staged (prettier + eslint on staged files)
echo "Step 1/4: Running lint-staged (prettier + eslint)..."
npx lint-staged || exit 1
echo "lint-staged passed."
echo ""

# Step 2: Backend tests
echo "Step 2/4: Running backend tests..."
npx jest backend/test/ --bail --forceExit --runInBand || exit 1
echo "Backend tests passed."
echo ""

# Step 3: CodeScene delta (optional - only if cs is available)
if command -v cs >/dev/null 2>&1; then
  echo "Step 3/4: Running CodeScene delta analysis..."
  cs delta --staged || exit 1
  echo "CodeScene check passed."
else
  echo "Step 3/4: CodeScene not found, skipping."
fi
echo ""

# Step 4: Code Review Checklist
echo "Step 4/4: Code Review Checklist"
echo "═══════════════════════════════════════════"
echo "  [ ] TDD pracen? (prvo test, pa kod)"
echo "  [ ] Domain cist? (nema infrastrukturnih zavisnosti)"
echo "  [ ] Ports koriste domain tipove? (ne entity)"
echo "  [ ] Nema duplikata koda?"
echo "  [ ] Build prolazi?"
echo "═══════════════════════════════════════════"
echo ""
echo "Ako bilo koji odgovor nije DA, razmisli o ispravci pre push-a."
echo ""

echo "All pre-commit checks passed!"
