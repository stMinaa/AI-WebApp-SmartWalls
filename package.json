{
  "name": "ai-aplikacija",
  "version": "1.0.0",
  "description": "This project is a full-stack web application for managing assemblies, buildings, and tenants, built with ASP.NET Core (backend) and React (frontend).",
  "main": "index.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "cd backend && node index.js",
    "backend": "cd backend && node index.js",
    "frontend": "cd frontend && npm start",
    "test": "jest backend/test/ --detectOpenHandles --forceExit --runInBand",
    "test:arch": "jest backend/test/architecture/ --verbose",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint backend/ --ext .js",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint backend/ --ext .js --fix",
    "lint:frontend": "frontend/node_modules/.bin/eslint frontend/src/ --ext .js,.jsx",
    "lint:frontend:fix": "frontend/node_modules/.bin/eslint frontend/src/ --ext .js,.jsx --fix",
    "deps:check": "cd backend && depcruise --config .dependency-cruiser.js models services routes middleware utils validators",
    "deps:graph": "cd backend && depcruise --config .dependency-cruiser.js --output-type dot models services routes middleware utils validators | dot -T svg > ../dependency-graph.svg",
    "quality": "npm run lint && npm run test:arch",
    "quality:full": "npm run lint && npm run deps:check && npm run test:arch && npm test",
    "format": "prettier --write \"backend/**/*.js\" \"frontend/src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"backend/**/*.js\" \"frontend/src/**/*.{js,jsx}\"",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1"
  },
  "devDependencies": {
    "@shelf/jest-mongodb": "^6.0.2",
    "dependency-cruiser": "^17.3.8",
    "eslint": "^9.39.2",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2"
  },
  "lint-staged": {
    "backend/**/*.js": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "frontend/src/**/*.{js,jsx}": [
      "prettier --write",
      "frontend/node_modules/.bin/eslint --fix --max-warnings 0"
    ]
  }
}
